{
  "name": "dsh-task-popup",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH 插件：任务完成或等待确认时弹出通知卡片 / Popup when a DSH task finishes or needs confirmation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "popup"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/methylorange/dsh-task-popup.git"
  },
  "homepage": "https://github.com/methylorange/dsh-task-popup#readme",
  "bugs": {
    "url": "https://github.com/methylorange/dsh-task-popup/issues"
  },
  "author": "methylorange",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
